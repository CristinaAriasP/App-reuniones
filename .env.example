# Copia este archivo como .env.local y rellena los valores de tu proyecto de Firebase
# (Configuración del proyecto → General → Tus apps → Configuración del SDK).
# No son secretos: identifican el proyecto. Los datos los protegen las reglas de firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=
