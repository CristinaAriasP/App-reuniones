rules_version = '2';

// Cada persona solo puede leer y escribir sus propios datos: users/{su uid}/...
// Nadie más (ni otros usuarios ni visitantes sin sesión) puede acceder a ellos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && collection in ['projects', 'meetings', 'tasks', 'deliverables', 'questions', 'answers'];
    }
  }
}
